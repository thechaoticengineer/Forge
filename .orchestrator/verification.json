{
  "schemaVersion": 1,
  "commands": [
    {
      "label": "Rust format",
      "program": "cargo",
      "arguments": ["fmt", "--all", "--", "--check"],
      "timeoutSeconds": 120
    },
    {
      "label": "Rust tests",
      "program": "cargo",
      "arguments": ["test", "--workspace"]
    },
    {
      "label": "Rust lint",
      "program": "cargo",
      "arguments": ["clippy", "--workspace", "--all-targets", "--", "-D", "warnings"]
    },
    {
      "label": "Omarchy plugin",
      "program": "omarchy",
      "arguments": ["plugin", "validate", "."],
      "timeoutSeconds": 120
    }
  ]
}
